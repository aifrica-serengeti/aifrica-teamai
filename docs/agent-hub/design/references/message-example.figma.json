    {
      "kind": "scope",
      "note": "Three example-action visuals enabled/hovered/pressed. This is not the delivered-user-message contract. Actual select behavior, draft replacement/append or immediate execution is not supplied by these static nodes."
    },
    {
      "kind": "geometry",
      "note": "All three samples HUG121x44, radius/surface-sm12, px20/py12/gap4, no actual border/shadow, clipping=false. Label message57x20 plus arrow20 plus gap4 plus horizontal padding40 explains sample width121; it is not a fixed product width."
    },
    {
      "kind": "palette",
      "note": "Enabled/hovered/pressed use color/action/primary-subtle, primary-subtle-hovered, primary-subtle-pressed (#EBF3FF/#CCE0FF/#99C2FF). This is not AgentHubButton secondary mapping; label weight400 differs from standard action button600."
    },
    {
      "kind": "text",
      "note": "Label is Pretendard Regular14/20/400 and #1C1C1C in all states. No root TEXT property is declared; a consumer label prop is a proposed API, not an existing Figma text binding."
    },
    {
      "kind": "icon",
      "note": "All three visible arrow-right20 instances point to2199:23690 at native20/stroke1.25/#1C1C1C. icon#2367:11 defaults true and binds each instance visible property. icon=false has no separately rendered sample; remove the glyph and its inter-item gap rather than retaining an empty slot."
    },
    {
      "kind": "source-vs-semantics",
      "note": "No Button/Card/UserMessage instance is present. A native action can follow common Button semantics or extend a suitable product variant, without claiming Figma Button reuse or inheriting its colors/font/radius."
    },
    {
      "kind": "state-semantics",
      "note": "Hovered and pressed are transient interaction visuals, not selected/sent/success/request-pending. No toggle, aria-pressed, route destination or send API is established by the arrow."
    },
    {
      "kind": "unverified",
      "note": "Only Light/icon-visible one-line samples. No icon-hidden render, disabled/focus/loading/dark, long/wrapped label/mobile, keyboard or selection-to-composer execution runtime is verified."
    }
