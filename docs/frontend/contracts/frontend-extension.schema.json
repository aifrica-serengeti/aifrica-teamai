{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:aifrica:frontend-extension:1",
  "title": "Aifrica frontend extension v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "solution"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "solution": {
      "enum": [
        "cmp",
        "paas",
        "agent-hub"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "reference"
      ]
    },
    "profile": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "$ref": "#/definitions/optionalPath"
        },
        "componentRegistry": {
          "$ref": "#/definitions/optionalPath"
        },
        "designTokens": {
          "$ref": "#/definitions/optionalPath"
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand": {
          "$ref": "#/definitions/tokenMap"
        },
        "color": {
          "$ref": "#/definitions/tokenMap"
        },
        "typography": {
          "$ref": "#/definitions/tokenMap"
        },
        "border": {
          "$ref": "#/definitions/tokenMap"
        },
        "spacing": {
          "$ref": "#/definitions/tokenMap"
        },
        "radius": {
          "$ref": "#/definitions/tokenMap"
        },
        "elevation": {
          "$ref": "#/definitions/tokenMap"
        },
        "motion": {
          "$ref": "#/definitions/tokenMap"
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "unmapped",
              "implemented"
            ]
          },
          "source": {
            "$ref": "#/definitions/optionalPath"
          },
          "export": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "implemented"
                }
              }
            },
            "then": {
              "required": [
                "source",
                "export"
              ],
              "properties": {
                "source": {
                  "$ref": "#/definitions/path"
                },
                "export": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "pagePatterns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "list": {
          "$ref": "#/definitions/pageSettings"
        },
        "create": {
          "$ref": "#/definitions/pageSettings"
        },
        "detail": {
          "$ref": "#/definitions/pageSettings"
        }
      }
    },
    "documentOverrides": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/path"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract",
          "reason",
          "scope"
        ],
        "properties": {
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reviewAfter": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "inheritCommon": {
      "type": "boolean",
      "description": "Shared frontend bundle opt-in; solution/local adoption only."
    }
  },
  "definitions": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/|[A-Za-z]:|~|.*\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "optionalPath": {
      "anyOf": [
        {
          "$ref": "#/definitions/path"
        },
        {
          "type": "null"
        }
      ]
    },
    "tokenMap": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ],
        "minLength": 1
      }
    },
    "pageSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxWidth": {
          "type": "string",
          "minLength": 1
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1
        },
        "pageSizeOptions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "defaultViewMode": {
          "enum": [
            "table",
            "card"
          ]
        },
        "tablePageSize": {
          "type": "integer",
          "minimum": 1
        },
        "cardPageSize": {
          "type": "integer",
          "minimum": 1
        },
        "tablePageSizeOptions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "cardPageSizeOptions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "searchDebounceMs": {
          "type": "integer",
          "minimum": 0
        },
        "layout": {
          "type": "string",
          "minLength": 1
        },
        "sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "navigationPolicy": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
