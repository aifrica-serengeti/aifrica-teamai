{
  "name": "agent-hub-component-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "teamai:sync": "node scripts/sync-teamai.mjs && node scripts/prepare-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "format": "prettier --write src scripts *.json *.md index.html",
    "format:check": "prettier --check src scripts *.json *.md index.html"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/poppins": "5.2.7",
    "pretendard": "1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
